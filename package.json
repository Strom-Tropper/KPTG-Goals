{
    "name": "igt-game-victory-road-fe",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "npm run dev",
        "build": "npm run build:prod",
        "build:prod": "assetpack && npm run lint && tsc && vite build",
        "build:dev": "assetpack && npm run lint && tsc && vite build --mode development",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "dev": "vite --mode development",
        "dev:host": "vite --mode development --host",
        "preview": "vite preview",
        "assetpack": "npx @assetpack/core build",
        "prepare": "husky",
        "build:js": "npx vite build",
        "knip": "knip"
    },
    "dependencies": {
        "@esotericsoftware/spine-pixi-v8": "4.2.109",
        "gsap": "^3.15.0",
        "pixi.js": "8.16.0"
    },
    "devDependencies": {
        "@assetpack/core": "1.7.0",
        "@eslint/js": "9.21.0",
        "@types/node": "^26.5.0",
        "dotenv": "17.4.2",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.2",
        "eslint-plugin-prettier": "5.2.6",
        "husky": "^9.1.7",
        "knip": "^6.34.0",
        "lint-staged": "^17.0.5",
        "prettier": "3.5.3",
        "typescript": "^5.7.3",
        "typescript-eslint": "8.25.0",
        "vite": "6.4.2"
    },
    "overrides": {
        "minimatch": "10.2.3"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,mjs,cjs,json}": [
            "prettier --write"
        ]
    }
}
